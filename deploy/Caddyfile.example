reversecaptcha.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:4408
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
}

www.reversecaptcha.example.com {
    redir https://reversecaptcha.example.com{uri} permanent
}
